{
  "name": "telnyx",
  "version": "3.0.0",
  "description": "The official TypeScript library for the Telnyx API",
  "author": "Telnyx <support@telnyx.com>",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "type": "commonjs",
  "repository": "github:team-telnyx/telnyx-node",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "files": [
    "**/*"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@7": "7.29.6",
      "@babel/helpers@7": "7.26.10",
      "@eslint/plugin-kit@<0.3.4": "0.3.4",
      "ajv@6": "6.14.0",
      "brace-expansion": "5.0.9",
      "diff@4": "4.0.4",
      "fast-uri@3": "3.1.5",
      "flatted@3": "3.4.2",
      "hono@4": "4.12.34",
      "js-yaml@3": "3.15.0",
      "js-yaml@4": "4.3.0",
      "minimatch@3": "3.1.4",
      "minimatch@5": "5.1.8",
      "minimatch@7": "7.4.8",
      "minimatch@9": "9.0.7",
      "node-forge@1": "1.4.0",
      "path-to-regexp@8": "8.4.2",
      "picomatch@2": "2.3.2",
      "tmp": "0.2.7"
    },
    "patchedDependencies": {
      "brace-expansion@5.0.9": "patches/brace-expansion@5.0.9.patch"
    }
  },
  "scripts": {
    "test": "./scripts/test",
    "build": "./scripts/build",
    "prepublishOnly": "echo 'to publish, run pnpm build && (cd dist; pnpm publish)' && exit 1",
    "format": "./scripts/format",
    "prepare": "if ./scripts/utils/check-is-in-git-install.sh; then ./scripts/build && ./scripts/utils/git-swap.sh; fi",
    "tsn": "ts-node -r tsconfig-paths/register",
    "lint": "./scripts/lint",
    "fix": "./scripts/format"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.0",
    "@swc/core": "^1.3.102",
    "@swc/jest": "^0.2.29",
    "@types/jest": "^29.4.0",
    "@types/node": "^20.17.6",
    "@typescript-eslint/eslint-plugin": "8.31.1",
    "@typescript-eslint/parser": "8.31.1",
    "eslint": "^9.39.1",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "iconv-lite": "^0.6.3",
    "jest": "^29.4.0",
    "prettier": "^3.0.0",
    "publint": "^0.2.12",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.5.0",
    "tsc-multi": "https://github.com/stainless-api/tsc-multi/releases/download/v1.1.11/tsc-multi.tgz",
    "tsconfig-paths": "^4.0.0",
    "tslib": "^2.8.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.31.1"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./*.mjs": {
      "default": "./dist/*.mjs"
    },
    "./*.js": {
      "default": "./dist/*.js"
    },
    "./*": {
      "import": "./dist/*.mjs",
      "require": "./dist/*.js"
    }
  }
}
